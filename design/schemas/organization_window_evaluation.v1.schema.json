{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_evaluation.v1.schema.json",
  "title": "IceLines Organization Window Evaluation v1",
  "type": "object",
  "required": [
    "schema",
    "target",
    "manifest_fingerprint",
    "training",
    "validation",
    "retrospective_holdout",
    "development_calibration",
    "claim_status",
    "disclosures",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_window_evaluation.v1" },
    "target": { "type": "string", "minLength": 1 },
    "manifest_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "training": { "$ref": "#/$defs/split" },
    "validation": { "$ref": "#/$defs/split" },
    "retrospective_holdout": { "$ref": "#/$defs/split" },
    "development_calibration": { "type": "object" },
    "claim_status": { "enum": ["calibrated", "inconclusive", "blocked"] },
    "disclosures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "metric": {
      "type": "object",
      "required": ["key", "sample_size", "mean_absolute_error", "baseline_mean_absolute_error", "rank_correlation", "claim_status"],
      "properties": {
        "key": { "const": "overall" },
        "sample_size": { "type": "integer", "minimum": 1 },
        "mean_absolute_error": { "type": "number", "minimum": 0 },
        "baseline_mean_absolute_error": { "type": "number", "minimum": 0 },
        "rank_correlation": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "claim_status": { "enum": ["calibrated", "inconclusive", "blocked"] }
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object",
      "required": ["role", "origin_ids", "overall", "leakage_blocked"],
      "properties": {
        "role": { "enum": ["training", "validation", "retrospective_holdout"] },
        "origin_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "overall": { "$ref": "#/$defs/metric" },
        "leakage_blocked": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
