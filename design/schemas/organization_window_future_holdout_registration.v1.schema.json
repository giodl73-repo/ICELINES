{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_future_holdout_registration.v1.schema.json",
  "title": "IceLines Organization Window Future Holdout Registration v1",
  "type": "object",
  "required": [
    "schema",
    "registration_id",
    "registered_at",
    "source_season",
    "target_season",
    "feature_cutoff",
    "outcome_not_before",
    "target",
    "origin_id",
    "board",
    "leakage_audit",
    "baseline_value",
    "acceptance",
    "source_fingerprints",
    "disclosures",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_window_future_holdout_registration.v1" },
    "registration_id": { "type": "string", "minLength": 1 },
    "registered_at": { "type": "string", "format": "date-time" },
    "source_season": { "type": "integer", "minimum": 19001901 },
    "target_season": { "type": "integer", "minimum": 19011902 },
    "feature_cutoff": { "type": "string", "format": "date" },
    "outcome_not_before": { "type": "string", "format": "date" },
    "target": { "type": "string", "minLength": 1 },
    "origin_id": { "type": "string", "minLength": 1 },
    "board": { "type": "object" },
    "leakage_audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_key", "method_version", "point_in_time_safe", "evidence"],
        "properties": {
          "profile_key": { "type": "string", "minLength": 1 },
          "method_version": { "type": "string", "minLength": 1 },
          "point_in_time_safe": { "const": true },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "baseline_value": { "const": 50.0 },
    "acceptance": {
      "type": "object",
      "required": [
        "minimum_sample_size",
        "require_mae_below_baseline",
        "minimum_rank_correlation",
        "require_complete_leakage_audit"
      ],
      "properties": {
        "minimum_sample_size": { "const": 32 },
        "require_mae_below_baseline": { "const": true },
        "minimum_rank_correlation": { "const": 0.3 },
        "require_complete_leakage_audit": { "const": true }
      },
      "additionalProperties": false
    },
    "source_fingerprints": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "disclosures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
