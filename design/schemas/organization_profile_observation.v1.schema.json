{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_profile_observation.v1.schema.json",
  "title": "IceLines Organization Profile Observation v1",
  "type": "object",
  "required": [
    "schema", "profile_key", "method_version", "organization",
    "organization_identity_version", "season", "season_type", "as_of",
    "horizon", "signal_family", "direction", "raw_unit", "sample_size",
    "confidence", "coverage", "status", "evidence", "limitations",
    "source_fingerprints"
  ],
  "properties": {
    "schema": { "const": "organization_profile_observation.v1" },
    "profile_key": { "type": "string", "minLength": 1 },
    "method_version": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "organization_identity_version": { "type": "string", "minLength": 1 },
    "season": { "type": "integer", "minimum": 19001901 },
    "season_type": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "horizon": { "enum": ["current", "one_year", "three_year", "five_year"] },
    "signal_family": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["higher_is_better", "lower_is_better", "target_range"] },
    "raw_value": { "type": ["number", "null"] },
    "raw_unit": { "type": "string", "minLength": 1 },
    "normalized_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "league_percentile": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "league_rank": { "type": ["integer", "null"], "minimum": 1 },
    "sample_size": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["observed", "modeled", "provisional", "blocked", "not_applicable"] },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "source_fingerprints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
