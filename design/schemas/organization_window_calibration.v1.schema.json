{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_calibration.v1.schema.json",
  "title": "IceLines Organization Window Calibration v1",
  "type": "object",
  "required": ["schema", "target", "board_fingerprint", "manifest_fingerprint", "leakage_audit", "overall", "dimensions", "disclosures"],
  "properties": {
    "schema": { "const": "organization_window_calibration.v1" },
    "target": { "type": "string", "minLength": 1 },
    "board_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "leakage_audit": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "overall": { "type": "object" },
    "dimensions": { "type": "array", "items": { "type": "object" } },
    "disclosures": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
