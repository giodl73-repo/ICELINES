{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_scenario_distribution.v1.schema.json",
  "title": "IceLines Organization Window Scenario Distribution v1",
  "type": "object",
  "required": ["schema", "scenario_id", "season", "as_of", "trials", "seed", "baseline_board_fingerprint", "central_impact", "organizations", "shocks", "disclosures", "fingerprint"],
  "properties": {
    "schema": { "const": "organization_window_scenario_distribution.v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "season": { "type": "integer", "minimum": 19001901 },
    "as_of": { "type": "string", "format": "date" },
    "trials": { "type": "integer", "minimum": 100 },
    "seed": { "type": "integer", "minimum": 0 },
    "baseline_board_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "central_impact": { "type": "object" },
    "organizations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/organization" } },
    "shocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shock" } },
    "disclosures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": {
      "type": "object",
      "required": ["mean", "p10", "p50", "p90", "positive_probability", "negative_probability"],
      "properties": {
        "mean": { "type": "number" },
        "p10": { "type": "number" },
        "p50": { "type": "number" },
        "p90": { "type": "number" },
        "positive_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "negative_probability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["dimension_key", "score_delta"],
      "properties": {
        "dimension_key": { "type": "string", "minLength": 1 },
        "score_delta": { "$ref": "#/$defs/summary" }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["organization", "overall_score_delta", "dimensions"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "overall_score_delta": { "$ref": "#/$defs/summary" },
        "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } }
      },
      "additionalProperties": false
    },
    "shock": {
      "type": "object",
      "required": ["organization", "profile_key", "method_version", "authority_id", "sampled_raw_delta", "activation_probability"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "profile_key": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "authority_id": { "type": "string", "minLength": 1 },
        "sampled_raw_delta": { "$ref": "#/$defs/summary" },
        "activation_probability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
