{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_profile_history.v1.schema.json",
  "title": "IceLines standing organization profile history",
  "type": "object",
  "required": [
    "schema",
    "history_id",
    "created_at",
    "organization_identity_version",
    "observations",
    "source_fingerprints",
    "disclosures",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_profile_history.v1" },
    "history_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "organization_identity_version": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile_key",
          "method_version",
          "organization",
          "organization_identity_version",
          "season",
          "season_type",
          "as_of",
          "horizon",
          "raw_unit",
          "sample_size",
          "confidence",
          "coverage",
          "status",
          "evidence",
          "limitations",
          "source_fingerprints"
        ],
        "properties": {
          "profile_key": { "type": "string", "minLength": 1 },
          "method_version": { "type": "string", "minLength": 1 },
          "organization": { "type": "string", "minLength": 2 },
          "organization_identity_version": { "type": "string", "minLength": 1 },
          "season": { "type": "integer", "minimum": 19001901 },
          "season_type": { "type": "string", "minLength": 1 },
          "as_of": { "type": "string", "format": "date" },
          "horizon": { "enum": ["current", "one_year", "three_year", "five_year"] },
          "raw_value": { "type": ["number", "null"] },
          "raw_unit": { "type": "string", "minLength": 1 },
          "sample_size": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "enum": ["observed", "modeled", "provisional", "blocked", "not_applicable"] },
          "evidence": { "type": "array", "items": { "type": "object" } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "source_fingerprints": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "source_fingerprints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disclosures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fingerprint": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
