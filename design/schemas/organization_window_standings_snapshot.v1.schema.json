{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_standings_snapshot.v1.schema.json",
  "title": "IceLines Organization Window Standings Snapshot v1",
  "type": "object",
  "required": ["schema", "target_season", "effective_date", "captured_at", "source_url", "source_projection_fingerprint", "organization_identity_version", "rows", "disclosures", "fingerprint"],
  "properties": {
    "schema": { "const": "organization_window_standings_snapshot.v1" },
    "target_season": { "type": "integer", "minimum": 19001901 },
    "effective_date": { "type": "string", "format": "date" },
    "captured_at": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_projection_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "organization_identity_version": { "const": "nhl_franchise_continuity_32.v1" },
    "rows": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "$ref": "#/$defs/row" } },
    "disclosures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "row": {
      "type": "object",
      "required": ["organization", "observed_team", "games_played", "wins", "losses", "overtime_losses", "points", "points_percentage", "goal_differential"],
      "properties": {
        "organization": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "observed_team": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "games_played": { "type": "integer", "minimum": 1 },
        "wins": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "overtime_losses": { "type": "integer", "minimum": 0 },
        "points": { "type": "integer", "minimum": 0 },
        "points_percentage": { "type": "number", "minimum": 0, "maximum": 1 },
        "goal_differential": { "type": "integer" }
      },
      "additionalProperties": false
    }
  }
}
