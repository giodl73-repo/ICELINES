{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.dev/schemas/identity_review_workboard.v1.schema.json",
  "title": "IceLines Identity Review Workboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluation_season", "source_package_id", "source_package_fingerprint", "effective_cutoff", "knowledge_cutoff", "unresolved_count", "family_counts", "rows", "disclosures"],
  "properties": {
    "schema": { "const": "identity_review_workboard.v1" },
    "evaluation_season": { "type": "integer", "minimum": 1 },
    "source_package_id": { "type": "string", "minLength": 1 },
    "source_package_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "effective_cutoff": { "type": "string", "format": "date-time" },
    "knowledge_cutoff": { "type": "string", "format": "date-time" },
    "unresolved_count": { "type": "integer", "minimum": 0 },
    "family_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "proposals"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "proposals": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "proposal_id", "displayed_name", "search_query", "providers", "evidence_urls", "evidence", "contexts"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "proposal_id": { "type": "string", "minLength": 1 },
          "displayed_name": { "type": "string", "minLength": 1 },
          "birth_date": { "type": "string" },
          "proposed_player_id": { "type": "integer", "minimum": 1 },
          "search_query": { "type": "string", "minLength": 1 },
          "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "source_url", "provider", "captured_at", "content_sha256", "adapter_version"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "source_url": { "type": "string", "format": "uri" },
                "provider": { "type": "string", "minLength": 1 },
                "captured_at": { "type": "string", "format": "date-time" },
                "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "adapter_version": { "type": "string", "minLength": 1 }
              }
            }
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["family", "detail"],
              "properties": {
                "family": { "type": "string", "minLength": 1 },
                "organization": { "type": "string", "minLength": 1 },
                "draft": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["year", "round", "overall"],
                  "properties": {
                    "year": { "type": "integer", "minimum": 1917, "maximum": 2200 },
                    "round": { "type": "integer", "minimum": 1 },
                    "overall": { "type": "integer", "minimum": 1 }
                  }
                },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "disclosures": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
