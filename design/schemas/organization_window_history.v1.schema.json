{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_history.v1.schema.json",
  "title": "IceLines Organization Window History v1",
  "type": "object",
  "required": ["schema", "season", "manifest_fingerprint", "checkpoint_fingerprints", "movements"],
  "properties": {
    "schema": { "const": "organization_window_history.v1" },
    "season": { "type": "integer" },
    "manifest_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkpoint_fingerprints": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "movements": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "additionalProperties": false
}
