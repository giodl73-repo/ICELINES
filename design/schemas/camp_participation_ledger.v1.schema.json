{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.dev/schemas/camp_participation_ledger.v1.schema.json",
  "title": "IceLines Camp Participation Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "season",
    "provider",
    "captured_at",
    "source_url",
    "coverage",
    "participants"
  ],
  "properties": {
    "schema": { "const": "camp_participation_ledger.v1" },
    "season": { "type": "integer", "minimum": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organization", "terminal", "records"],
        "properties": {
          "organization": { "type": "string", "minLength": 1 },
          "terminal": { "const": true },
          "records": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "player_id",
          "organization",
          "kind",
          "authority",
          "occurred_at",
          "source_url"
        ],
        "properties": {
          "player_id": { "type": "integer", "minimum": 1 },
          "organization": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "development_camp",
              "rookie_camp",
              "training_camp",
              "prospect_tournament"
            ]
          },
          "authority": {
            "enum": ["controlled_player", "free_agent_invite", "tryout", "unknown"]
          },
          "occurred_at": { "type": "string", "format": "date-time" },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
