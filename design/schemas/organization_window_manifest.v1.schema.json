{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_manifest.v1.schema.json",
  "title": "IceLines Organization Window Manifest v1",
  "type": "object",
  "required": [
    "schema", "manifest_id", "label", "description", "manifest_version",
    "comparison_cohort", "normalization_method", "primary_horizon",
    "dimensions", "missing_policy", "classification_method", "created_at",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_window_manifest.v1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "manifest_version": { "type": "string", "minLength": 1 },
    "comparison_cohort": {
      "type": "object",
      "required": ["kind", "team_catalog_version", "expected_organizations"],
      "properties": {
        "kind": { "enum": ["current_nhl", "season_canonical"] },
        "team_catalog_version": { "type": "string", "minLength": 1 },
        "expected_organizations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "normalization_method": { "const": "empirical_percentile" },
    "primary_horizon": { "enum": ["current", "one_year", "three_year", "five_year"] },
    "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } },
    "missing_policy": { "const": "withhold_rank" },
    "classification_method": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["key", "label", "weight", "minimum_coverage", "rank_required", "profiles", "signal_family_caps"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "minimum_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "rank_required": { "type": "boolean" },
        "profiles": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "signal_family_caps": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
