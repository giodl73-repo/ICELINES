{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/team_game_prediction_training.v1.schema.json",
  "title": "IceCast game-prediction training result",
  "type": "object",
  "required": ["schema", "config", "observations", "seasons", "model", "pruned_features", "input_fingerprint", "fingerprint"],
  "properties": {
    "schema": { "const": "team_game_prediction_training.v1" },
    "config": { "type": "object" },
    "observations": { "type": "integer", "minimum": 1 },
    "seasons": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "model": { "type": "object" },
    "pruned_features": { "type": "array", "items": { "type": "string" } },
    "input_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }
  },
  "additionalProperties": false
}
