{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_board.v1.schema.json",
  "title": "IceLines Organization Window Board v1",
  "type": "object",
  "required": [
    "schema", "registry_version", "season", "season_type", "as_of",
    "generated_at", "manifest", "source_fingerprints", "league_coverage",
    "expected_organizations", "organizations", "disclosures", "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_window_board.v1" },
    "registry_version": { "type": "string", "minLength": 1 },
    "season": { "type": "integer", "minimum": 19001901 },
    "season_type": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "minLength": 1 },
    "manifest": { "type": "object" },
    "source_fingerprints": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "league_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_organizations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "organizations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "disclosures": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
