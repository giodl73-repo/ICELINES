{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_profile_history_delta.v1.schema.json",
  "title": "IceLines organization profile history delta",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "history_id",
    "history_fingerprint",
    "organization_identity_version",
    "earlier",
    "later",
    "expected_organizations",
    "comparable_profiles",
    "organizations",
    "disclosures",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "organization_profile_history_delta.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "history_id": { "type": "string", "minLength": 1 },
    "history_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "organization_identity_version": { "type": "string", "minLength": 1 },
    "earlier": { "$ref": "#/$defs/checkpoint" },
    "later": { "$ref": "#/$defs/checkpoint" },
    "expected_organizations": { "type": "integer", "minimum": 1 },
    "comparable_profiles": { "type": "integer", "minimum": 0 },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "organization",
          "comparable_profiles",
          "improved_profiles",
          "declined_profiles",
          "unchanged_profiles",
          "profiles"
        ],
        "properties": {
          "organization": { "type": "string", "minLength": 2 },
          "comparable_profiles": { "type": "integer", "minimum": 0 },
          "improved_profiles": { "type": "integer", "minimum": 0 },
          "declined_profiles": { "type": "integer", "minimum": 0 },
          "unchanged_profiles": { "type": "integer", "minimum": 0 },
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "profile_key",
                "method_version",
                "registered",
                "raw_unit",
                "earlier_raw_value",
                "later_raw_value",
                "raw_delta",
                "directional_delta",
                "confidence_delta",
                "coverage_delta",
                "change"
              ],
              "properties": {
                "profile_key": { "type": "string", "minLength": 1 },
                "method_version": { "type": "string", "minLength": 1 },
                "registered": { "type": "boolean" },
                "label": { "type": "string", "minLength": 1 },
                "dimension": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["higher_is_better", "lower_is_better", "target_range"] },
                "raw_unit": { "type": "string" },
                "earlier_raw_value": { "type": ["number", "null"] },
                "later_raw_value": { "type": ["number", "null"] },
                "raw_delta": { "type": ["number", "null"] },
                "directional_delta": { "type": ["number", "null"] },
                "confidence_delta": { "type": ["number", "null"] },
                "coverage_delta": { "type": ["number", "null"] },
                "change": { "enum": ["improved", "declined", "unchanged", "not_comparable"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "disclosures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": ["season", "as_of", "horizon"],
      "properties": {
        "season": { "type": "integer", "minimum": 19001901 },
        "as_of": { "type": "string", "format": "date" },
        "horizon": { "enum": ["current", "one_year", "three_year", "five_year"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
