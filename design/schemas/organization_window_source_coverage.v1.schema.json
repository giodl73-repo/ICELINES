{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_source_coverage.v1.schema.json",
  "title": "IceLines Organization Window Source Coverage v1",
  "type": "object",
  "required": [
    "schema",
    "season",
    "as_of",
    "package_fingerprint",
    "board_fingerprint",
    "expected_organizations",
    "profiles",
    "complete_required_profiles",
    "required_profiles",
    "rank_eligible_organizations",
    "production_ranked",
    "disclosures"
  ],
  "properties": {
    "schema": { "const": "organization_window_source_coverage.v1" },
    "season": { "type": "integer", "minimum": 19001901 },
    "as_of": { "type": "string", "format": "date" },
    "package_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "board_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "expected_organizations": { "const": 32 },
    "profiles": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": [
          "profile_key",
          "method_version",
          "required",
          "organizations_with_observation",
          "organizations_with_value",
          "missing_organizations",
          "complete"
        ],
        "properties": {
          "profile_key": { "type": "string", "minLength": 1 },
          "method_version": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "organizations_with_observation": { "type": "integer", "minimum": 0, "maximum": 32 },
          "organizations_with_value": { "type": "integer", "minimum": 0, "maximum": 32 },
          "missing_organizations": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "minLength": 2 }
          },
          "complete": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "complete_required_profiles": { "type": "integer", "minimum": 0, "maximum": 16 },
    "required_profiles": { "const": 16 },
    "rank_eligible_organizations": { "type": "integer", "minimum": 0, "maximum": 32 },
    "carry_forward_observations": { "type": "integer", "minimum": 0 },
    "production_ranked": { "type": "boolean" },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
