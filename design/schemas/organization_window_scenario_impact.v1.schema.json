{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_scenario_impact.v1.schema.json",
  "title": "IceLines Organization Window Scenario Impact v1",
  "type": "object",
  "required": ["schema", "scenario_id", "season", "as_of", "manifest_fingerprint", "baseline_board_fingerprint", "scenario_board_fingerprint", "organizations", "disclosures"],
  "properties": {
    "schema": { "const": "organization_window_scenario_impact.v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "season": { "type": "integer" },
    "as_of": { "type": "string", "format": "date" },
    "manifest_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseline_board_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario_board_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority" }
    },
    "profile_impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile_impact" }
    },
    "organizations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "disclosures": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "profile_method": {
      "type": "object",
      "required": ["profile_key", "method_version"],
      "properties": {
        "profile_key": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["authority_id", "kind", "source_schema", "source_fingerprint", "organizations", "profile_methods", "rationale"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["trade", "injury", "goalie", "player_development", "training_camp", "line_combination", "custom"] },
        "source_schema": { "type": "string", "minLength": 1 },
        "source_fingerprint": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
        "organizations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
        "profile_methods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile_method" } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "profile_impact": {
      "type": "object",
      "required": ["organization", "dimension_key", "profile_key", "method_version", "kind", "raw_delta", "score_delta", "confidence_delta", "coverage_delta", "authority_ids"],
      "properties": {
        "organization": { "type": "string", "minLength": 2 },
        "dimension_key": { "type": "string", "minLength": 1 },
        "profile_key": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["raw_input", "evidence", "cohort_revaluation", "unchanged"] },
        "raw_delta": { "type": ["number", "null"] },
        "score_delta": { "type": ["number", "null"] },
        "confidence_delta": { "type": "number" },
        "coverage_delta": { "type": "number" },
        "authority_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
