{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/team_game_prediction_edge.v1.schema.json",
  "title": "IceCast team game prediction edge",
  "type": "object",
  "required": ["schema", "season", "vintage", "generated_at", "model", "source_forecast_fingerprint", "games", "enhanced_forecast", "warnings", "disclosures", "fingerprint"],
  "properties": {
    "schema": { "const": "team_game_prediction_edge.v1" },
    "season": { "type": "integer", "minimum": 20000000 },
    "vintage": { "enum": ["preseason", "game_morning", "pregame_confirmed"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "model": { "type": "object" },
    "source_forecast_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "games": { "type": "array", "items": { "type": "object" } },
    "enhanced_forecast": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "disclosures": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }
  },
  "additionalProperties": false
}
