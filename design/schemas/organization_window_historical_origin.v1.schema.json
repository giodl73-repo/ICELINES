{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/organization_window_historical_origin.v1.schema.json",
  "title": "IceLines Organization Window Historical Origin v1",
  "type": "object",
  "required": ["schema", "source_season", "target_season", "as_of", "role", "origin", "source_fingerprints", "disclosures", "fingerprint"],
  "properties": {
    "schema": { "const": "organization_window_historical_origin.v1" },
    "source_season": { "type": "integer", "minimum": 19001901 },
    "target_season": { "type": "integer", "minimum": 19001901 },
    "as_of": { "type": "string", "format": "date" },
    "role": { "enum": ["training", "validation", "retrospective_holdout"] },
    "origin": {
      "type": "object",
      "required": ["origin_id", "board", "outcomes", "leakage_audit", "baseline_value"],
      "properties": {
        "origin_id": { "type": "string", "minLength": 1 },
        "board": { "type": "object" },
        "outcomes": { "type": "array", "minItems": 32, "maxItems": 32, "items": { "type": "object" } },
        "leakage_audit": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "baseline_value": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "source_fingerprints": { "type": "array", "minItems": 3, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "disclosures": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
