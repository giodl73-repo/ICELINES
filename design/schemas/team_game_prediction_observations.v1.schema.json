{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icelines.app/schemas/team_game_prediction_observations.v1.schema.json",
  "title": "IceCast frozen game-prediction observations",
  "type": "object",
  "required": ["schema", "vintage", "created_at", "seasons", "edge_fingerprints", "outcome_source_fingerprints", "observations", "fingerprint"],
  "properties": {
    "schema": { "const": "team_game_prediction_observations.v1" },
    "vintage": { "enum": ["preseason", "game_morning", "pregame_confirmed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "seasons": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 20000000 } },
    "edge_fingerprints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" } },
    "outcome_source_fingerprints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" } },
    "observations": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "fingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }
  },
  "additionalProperties": false
}
